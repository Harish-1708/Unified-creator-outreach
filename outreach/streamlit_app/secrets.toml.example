# Copy the relevant parts of this into Streamlit Secrets (Community Cloud:
# App settings -> Secrets). NEVER commit a real secrets.toml to the repo —
# it's already covered by .gitignore's *.toml exclusion if you add one, but
# double check before pushing.

shared_sheet_id = "PUT_YOUR_GOOGLE_SHEET_ID_HERE"  # same one as config/settings.yaml

[github]
# Fine-grained PAT scoped to ONLY this repo.
# Phase 1/2 (Dashboard, Preview, Send, Check Replies): Actions: Read and write
# Phase 3 (New Campaign PRs) also needs: Contents: Read and write, Pull requests: Read and write
token = "github_pat_..."
owner = "your-github-username-or-org"
repo = "Email-Outreach-Automation-main"

[google_sheets_readonly]
# Full JSON of a SEPARATE service account, shared to the Sheet as VIEWER
# only. Do NOT reuse the Editor-scoped GOOGLE_SERVICE_ACCOUNT_JSON that
# GitHub Actions uses to send email — this dashboard should never be able
# to write anything.
[google_sheets_readonly.service_account_json]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-readonly@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# Generate each user's block with: python streamlit_app/tools/generate_password_hash.py
[auth_users.alice]
salt = "..."
password_hash = "..."

[auth_users.bob]
salt = "..."
password_hash = "..."
